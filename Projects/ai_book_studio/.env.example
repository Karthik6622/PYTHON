# Copy to .env (gitignored) or put the same names in .streamlit/secrets.toml.
NVIDIA_API_KEY=your-nvidia-api-key
# NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
# NVIDIA_ENABLE_THINKING=false
# NVIDIA_REASONING_BUDGET=4096

# Image generation: Cloudflare FLUX first (fast), AI Horde as backup when Cloudflare's daily allowance is used up.
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_API_TOKEN=          # needs the "Workers AI" permission
# CLOUDFLARE_STEPS=6             # 1-8
# Without Cloudflare, AI Horde (FLUX by default) draws the images. Without either, placeholder art is used.
AI_HORDE_API_KEY=
# AI_HORDE_MODEL=Flux.1-Schnell fp8 (Compact)   # comma separated; default is FLUX schnell (4 steps, small images). Avoid step-limited models such as DreamShaper XL (they force upfront kudos)
# AI_HORDE_STEPS=16              # SDXL models only: 12-25 is fine (fewer = faster); FLUX always uses 4 steps
# AI_HORDE_FAST_ONLY=false      # true = fast workers only; AI Horde then demands upfront kudos for EVERY request, so leave it off without kudos
# AI_HORDE_TIMEOUT=600           # seconds to wait in the AI Horde queue per image
# AI_HORDE_CONCURRENCY=3         # images requested at the same time
# IMAGE_RETRIES=2                # extra tries per image when it fails or comes back blurry (0-5); a good first image is used at once
# IMAGE_MIN_SHARPNESS=25         # below this edge-contrast score a picture counts as blurry (0 = no blur check)
# IMAGE_PROVIDER=auto            # auto | cloudflare | ai_horde | api | placeholder

# Audiobook with OpenAI tts-1 on Pollinations (key from enter.pollinations.ai; it must allow the audio models).
# POLLINATIONS_API_KEY=
# POLLINATIONS_TTS_MODEL=openai/tts-1   # or openai/tts-1-hd
# TTS_VOICE=alloy                       # alloy | echo | fable | onyx | nova | shimmer
# TTS_WORKERS=3
# Alternative engine: Kokoro on fal.ai (English, Spanish, French). Used when no Pollinations key is set.
# FAL_KEY=
# TTS_PROVIDER=auto                     # auto | pollinations | fal

# Chapters written at the same time (1-8, default 4)
# CHAPTER_WORKERS=4

# Alternative: OpenAI-compatible /images/generations (used only when AI Horde is not configured).
IMAGE_API_KEY=
# IMAGE_API_RESPONSE_FORMAT=     # for example b64_json when the provider needs it
# IMAGE_API_SIZE_PORTRAIT=1024x1536
# IMAGE_API_SIZE_LANDSCAPE=1536x1024
# IMAGE_API_SIZE_SQUARE=1024x1024
# IMAGE_API_EXTRA_JSON={"quality":"medium"}
