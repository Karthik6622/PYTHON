# Copy to .env (gitignored) or put the same names in .streamlit/secrets.toml.
NVIDIA_API_KEY=your-nvidia-api-key
# NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
# NVIDIA_ENABLE_THINKING=false
# NVIDIA_REASONING_BUDGET=4096

# Image generation with Cloudflare Workers AI (FLUX.1 schnell). Without it, placeholder art is used.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# IMAGE_PROVIDER=auto            # auto | cloudflare | api | placeholder

# Audiobook with NVIDIA Magpie TTS Zeroshot (uses NVIDIA_API_KEY). Function id: build.nvidia.com -> magpie-tts-zeroshot -> Python example.
# NVIDIA_TTS_FUNCTION_ID=
# NVIDIA_TTS_VOICE=Magpie-ZeroShot.Female-1

# Chapters written at the same time (1-8, default 4)
# CHAPTER_WORKERS=4

# Alternative: OpenAI-compatible /images/generations (used only when Cloudflare is not configured).
IMAGE_API_KEY=
# IMAGE_API_RESPONSE_FORMAT=     # for example b64_json when the provider needs it
# IMAGE_API_SIZE_PORTRAIT=1024x1536
# IMAGE_API_SIZE_LANDSCAPE=1536x1024
# IMAGE_API_SIZE_SQUARE=1024x1024
# IMAGE_API_EXTRA_JSON={"quality":"medium"}
