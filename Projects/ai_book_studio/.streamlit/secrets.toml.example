# Copy to .streamlit/secrets.toml (gitignored). Never commit real keys.
NVIDIA_API_KEY = "your-nvidia-api-key"

# Image generation. Cloudflare FLUX is fast (dedicated GPUs, free daily allowance); AI Horde is the backup
# when that allowance runs out. Without either, placeholder art is used.
# CLOUDFLARE_ACCOUNT_ID = "your-cloudflare-account-id"
# CLOUDFLARE_API_TOKEN = "your-cloudflare-api-token"   # needs the "Workers AI" permission
AI_HORDE_API_KEY = "your-ai-horde-api-key"

# Audiobook: OpenAI tts-1 on Pollinations (the key must allow the audio models; the account needs Pollen).
# POLLINATIONS_API_KEY = ""
# POLLINATIONS_TTS_MODEL = "openai/tts-1"
# TTS_VOICE = "alloy"
# Alternative engine, used only when no Pollinations key is set: Kokoro on fal.ai.
# FAL_KEY = ""

# Optional: how many chapters are written at the same time (1-8, default 4).
# CHAPTER_WORKERS = 4

# Alternative OpenAI-compatible image API (used only when AI Horde is not configured).
IMAGE_API_KEY = ""
# IMAGE_API_URL = "https://api.openai.com/v1/images/generations"
# IMAGE_API_MODEL = "gpt-image-1"

# ---------------------------------------------------------------------------------------------
# Sign-in with Google and GitHub (email + password sign-up works without any of this).
# Keep these tables at the END of the file: in TOML, every top-level key above must come first.
# Redirect URLs: use http://localhost:8501/... while testing, your real https://... address once deployed.
# ---------------------------------------------------------------------------------------------

# Google: Google Cloud Console > APIs & Services > Credentials > OAuth client ID (Web application).
#   Authorised redirect URI: the redirect_uri below.
# [auth]
# redirect_uri = "http://localhost:8501/oauth2callback"
# cookie_secret = "generate-a-long-random-string"     # e.g. python -c "import secrets; print(secrets.token_hex(32))"
#
# [auth.google]
# client_id = "your-google-client-id.apps.googleusercontent.com"
# client_secret = "your-google-client-secret"
# server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"

# GitHub: Settings > Developer settings > OAuth Apps > New OAuth App.
#   Authorization callback URL: the redirect_uri below (the app's own address, no extra path).
# [github]
# client_id = "your-github-client-id"
# client_secret = "your-github-client-secret"
# redirect_uri = "http://localhost:8501"
