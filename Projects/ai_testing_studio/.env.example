# Copy to .env (never commit .env) or put the same keys in .streamlit/secrets.toml.

# ---- Model (any OpenAI-compatible endpoint; Nemotron by default) -------------------------
MODEL_PROVIDER=nvidia
MODEL_NAME=nvidia/nemotron-3.5-super-vl-120b-a12b
MODEL_BASE_URL=https://integrate.api.nvidia.com/v1
MODEL_API_KEY=
# NVIDIA_API_KEY is accepted as an alias of MODEL_API_KEY.
MODEL_TEMPERATURE=0.6
MODEL_TOP_P=0.95
MODEL_MAX_TOKENS=16384
MODEL_SEED=42
MODEL_ENABLE_THINKING=true
MODEL_TIMEOUT_SECONDS=300
MODEL_MAX_RETRIES=3
# Rough prompt budget (tokens) used to trim discovery data before it is sent to the model.
MODEL_CONTEXT_BUDGET_TOKENS=60000
# Send page screenshots to the vision-language model during discovery (true/false).
MODEL_USE_VISION=true

# ---- Storage -----------------------------------------------------------------------------
# sqlite:///relative/or/absolute/path.db  (PostgreSQL is a planned backend, see README)
DATABASE_URL=sqlite:///data/studio.db
DATA_DIR=data

# ---- Discovery ---------------------------------------------------------------------------
# Block private/loopback addresses (protects a hosted studio from being used to probe internal networks).
# Set to true when you test an application running on localhost / your intranet.
ALLOW_PRIVATE_NETWORK=false
DISCOVERY_TIMEOUT_SECONDS=240
DISCOVERY_DEFAULT_MAX_PAGES=8
DISCOVERY_DEFAULT_DEPTH=2

# ---- Execution ---------------------------------------------------------------------------
# docker (recommended, isolated container) or local (separate OS process, no container isolation).
EXECUTION_MODE=docker
EXECUTION_TIMEOUT_SECONDS=1800
DOCKER_CPUS=2
DOCKER_MEMORY=3g
DOCKER_SHM_SIZE=1g
# bridge (default; the tests must reach the application) or none (offline runs).
DOCKER_NETWORK=bridge
PLAYWRIGHT_VERSION=1.49.0
RUNNER_IMAGE_PLAYWRIGHT_PYTHON=mcr.microsoft.com/playwright/python:v1.49.0-jammy
RUNNER_IMAGE_PLAYWRIGHT_NODE=mcr.microsoft.com/playwright:v1.49.0-jammy
RUNNER_IMAGE_SELENIUM_PYTHON=ats-runner-selenium-python
RUNNER_IMAGE_SELENIUM_JAVA=ats-runner-selenium-java

# ---- Self-healing ------------------------------------------------------------------------
HEALING_ENABLED=true
HEALING_MAX_ATTEMPTS=2
HEALING_MIN_CONFIDENCE=0.6
# manual: proposals wait for Accept/Reject.  auto_pr: healed locators open a pull request (never merged automatically).
HEALING_APPROVAL_POLICY=manual
# Re-run an unexplained failure once; a pass on retry is reported as INCONCLUSIVE (flaky), never PASS.
RECHECK_FLAKY=true

# ---- GitHub (optional) ---------------------------------------------------------------------
# A token can also be typed in the GitHub page; it is then kept in the browser session only.
GITHUB_TOKEN=
GITHUB_API_URL=https://api.github.com

# ---- Credentials for authenticated applications (referenced by NAME in the project settings)
# TEST_APP_USERNAME=
# TEST_APP_PASSWORD=
