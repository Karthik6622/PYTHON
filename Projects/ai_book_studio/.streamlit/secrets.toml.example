# Copy to .streamlit/secrets.toml (gitignored). Never commit real keys.
NVIDIA_API_KEY = "your-nvidia-api-key"

# Image generation with AI Horde (AlbedoBase XL). Without it, placeholder art is used.
AI_HORDE_API_KEY = "your-ai-horde-api-key"

# Audiobook (Kokoro text-to-speech on fal.ai).
# FAL_KEY = ""
# FAL_TTS_VOICE = "af_heart"

# Optional: how many chapters are written at the same time (1-8, default 4).
# CHAPTER_WORKERS = 4

# Alternative OpenAI-compatible image API (used only when AI Horde is not configured).
IMAGE_API_KEY = ""
# IMAGE_API_URL = "https://api.openai.com/v1/images/generations"
# IMAGE_API_MODEL = "gpt-image-1"
