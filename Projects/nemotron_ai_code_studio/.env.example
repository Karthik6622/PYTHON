# Copy to .env and fill in. Never commit .env.

# NVIDIA API key (https://build.nvidia.com). Can also be entered in Settings (kept in memory only).
NVIDIA_API_KEY=

# GitHub personal access token (classic "repo" scope, or a fine-grained token with Contents read/write).
# For your own computer only. On a shared deployment every visitor connects GitHub in the app (account button in the top bar),
# and this value is ignored unless ALLOW_SHARED_GITHUB_TOKEN=1.
GITHUB_TOKEN=

# Lets visitors sign in with GitHub instead of pasting a token: the Client ID of a GitHub OAuth App with "Enable Device Flow" ticked
# (GitHub > Settings > Developer settings > OAuth Apps). It is public; no client secret is needed.
# GITHUB_CLIENT_ID=
# ALLOW_SHARED_GITHUB_TOKEN=0
# STUDIO_HOSTED=1

# Folder where cloned repositories live. Defaults to ./workspaces next to this file.
WORKSPACE_PATH=


# ---- Optional ----
# NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# NVIDIA_MODEL=nvidia/nemotron-3-ultra-550b-a55b
# NVIDIA_MODELS=org/extra-model-a,org/extra-model-b
# NVIDIA_EXTRA_BODY_JSON=
# NVIDIA_TIMEOUT_SECONDS=600
# NVIDIA_MODEL_FALLBACK=1
# AGENT_TURN_RETRIES=2
# NVIDIA_MAX_RETRIES=3
# NVIDIA_CONTEXT_TOKENS=100000
# CONTEXT_BUDGET_TOKENS=24000
# TERMINAL_SHELL=
# COMMAND_TIMEOUT_SECONDS=120
# AGENT_MAX_STEPS=30
# AUTO_VALIDATE=true
# MAX_FILE_BYTES=1000000

# Terminal command timeout in seconds (default 1800)
TERMINAL_TIMEOUT_SECONDS=
# Set to 0 to force the in-app folder browser instead of the native OS folder dialog
NATIVE_FOLDER_DIALOG=
