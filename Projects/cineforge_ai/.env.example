# Local-development fallback. Prefer .streamlit/secrets.toml.
# Copy this file to .env and never commit real values.

# Default provider: free LTX-Video Hugging Face Space - no key needed.
# Optional: a free Hugging Face token (https://huggingface.co/settings/tokens) raises the daily GPU quota.
# HF_TOKEN=hf_your-token-here
# When the Space quota is used up the app falls back to AI key-frames with camera motion (Pollinations).
# Optional free key (https://enter.pollinations.ai) removes its 1-image-per-45s limit:
# POLLINATIONS_API_KEY=sk_your-key-here
# Always use the quota-free renderer: VIDEO_PROVIDER=pictures

# To use NVIDIA Cosmos3-Nano instead, uncomment these:
# VIDEO_PROVIDER=nvidia
# NVIDIA_API_KEY=nvapi-your-key-here
# Optional: override the invocation URL from the model page's "View API Code" panel.
# NVIDIA_API_URL=https://ai.api.nvidia.com/v1/cosmos/nvidia/cosmos3-nano
