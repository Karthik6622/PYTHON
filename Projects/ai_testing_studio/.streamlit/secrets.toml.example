# Copy to .streamlit/secrets.toml (gitignored). Never commit real keys.
NVIDIA_API_KEY = "your-nvidia-api-key"

# Credentials of the application under test, referenced by NAME in the project settings.
# TEST_APP_USERNAME = "your-test-user"
# TEST_APP_PASSWORD = "your-test-password"

# ---------------------------------------------------------------------------------------------
# Sign-in with Google and GitHub, and emailed password-reset codes. All optional: email + password
# sign-up works without any of this. Keep these tables at the END of the file: in TOML, every
# top-level key above must come first. Use http://localhost:8501/... while testing and your real
# https://... address once deployed.
# ---------------------------------------------------------------------------------------------

# Google: Google Cloud Console > APIs & Services > Credentials > OAuth client ID (Web application).
#   Authorised redirect URI: the redirect_uri below.
# [auth]
# redirect_uri = "http://localhost:8501/oauth2callback"
# cookie_secret = "generate-a-long-random-string"     # python -c "import secrets; print(secrets.token_hex(32))"
#
# [auth.google]
# client_id = "your-google-client-id.apps.googleusercontent.com"
# client_secret = "your-google-client-secret"
# server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"

# GitHub: Settings > Developer settings > OAuth Apps > New OAuth App.
#   Authorization callback URL: the redirect_uri below (the app's own address, no extra path).
# [github]
# client_id = "your-github-client-id"
# client_secret = "your-github-client-secret"
# redirect_uri = "http://localhost:8501"

# Forgot password: with these set, a 6-digit code is emailed and must be entered before a new password is accepted.
# WITHOUT them, anyone who knows an account's email can set a new password for it, so set them before going public.
# (Gmail: turn on 2-step verification, then create an App password and use it here.)
# [smtp]
# host = "smtp.gmail.com"
# port = 587
# username = "your-sender-address"
# password = "your-app-password"
# from_address = "RK Testing Studio <your-sender-address>"   # optional
