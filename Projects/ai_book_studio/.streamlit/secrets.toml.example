# Copy to .streamlit/secrets.toml (gitignored). Never commit real keys.
NVIDIA_API_KEY = "your-nvidia-api-key"

# Image generation with Cloudflare Workers AI (FLUX.1 schnell). Without it, placeholder art is used.
CLOUDFLARE_ACCOUNT_ID = "your-cloudflare-account-id"
CLOUDFLARE_API_TOKEN = "your-cloudflare-api-token"

# Audiobook (Magpie TTS Zeroshot uses the same NVIDIA_API_KEY).
# Copy the function id from build.nvidia.com -> magpie-tts-zeroshot -> Python example (--metadata function-id ...).
# NVIDIA_TTS_FUNCTION_ID = ""
# NVIDIA_TTS_VOICE = "Magpie-ZeroShot.Female-1"

# Optional: how many chapters are written at the same time (1-8, default 4).
# CHAPTER_WORKERS = 4

# Alternative OpenAI-compatible image API (used only when Cloudflare is not configured).
IMAGE_API_KEY = ""
# IMAGE_API_URL = "https://api.openai.com/v1/images/generations"
# IMAGE_API_MODEL = "gpt-image-1"
