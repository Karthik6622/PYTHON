# Copy to .env for local development. Never commit real credentials.
NVIDIA_API_KEY=your-nvidia-api-key
# Tavily web search, used only for questions that need current information:
TAVILY_API_KEY=your-tavily-api-key
# Voice chat. Groq provides Whisper (speech-to-text fallback) and spoken replies:
GROQ_API_KEY=your-groq-api-key
# Image creation in chat (same providers as AI Book Studio). Cloudflare first, AI Horde as backup:
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_API_TOKEN=          # needs the "Workers AI" permission
# AI_HORDE_API_KEY=
# Optional voice overrides:
# VOICE_STT_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning
# GROQ_STT_MODEL=whisper-large-v3
# GROQ_TTS_MODEL=canopylabs/orpheus-v1-english
# GROQ_TTS_VOICE=hannah
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_MODEL=nvidia/nemotron-3.5-bolt-e4b
LLM_TEMPERATURE=0.6
LLM_MAX_TOKENS=1200

# Optional GitHub OAuth app settings:
GITHUB_CLIENT_ID=your-github-oauth-client-id
GITHUB_CLIENT_SECRET=your-github-oauth-client-secret
GITHUB_REDIRECT_URI=http://localhost:8501
